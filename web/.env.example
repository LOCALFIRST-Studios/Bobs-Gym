# Public site URL used for canonical links, Open Graph URLs and the sitemap.
VITE_SITE_URL=https://bobsgym.org

# Optional. URL that accepts a JSON POST of { name, email, subject, message }
# (e.g. a form service or the gym's own API). When empty, the contact form
# opens the visitor's email app addressed to support@bobsgym.org instead.
VITE_CONTACT_ENDPOINT=
